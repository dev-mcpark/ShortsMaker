# ============================================
# ShortsMaker Configuration Template
# ============================================
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요.
# cp config/.env.example config/.env
#
# 또는 프로젝트 루트에 .env 파일을 생성해도 됩니다.
# ============================================

# --------------------------------------------
# 1. Generation Mode
# --------------------------------------------
# "hybrid" - 첫 장면 Veo 영상, 나머지 Gemini 이미지 (기본값)
# "image" - 전체 Gemini 이미지
# "video" - 전체 Veo 영상 (비용 상한 조정 필요)
GENERATION_MODE="hybrid"

# --------------------------------------------
# 2. OpenAI API (자동 기획·내레이션 생성 시 필수)
# --------------------------------------------
# 용도: GPT-4o (스크립트 생성), TTS (나레이션)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your-api-key-here"

# --------------------------------------------
# 3. Google Cloud Platform (자동 비주얼 생성 시 필수)
# --------------------------------------------
# 용도: Veo (AI 영상), Gemini (AI 이미지)
# 설정 가이드: config/README.md 참조
#
# 프로젝트 ID (GCP Console에서 확인)
GCP_PROJECT_ID="your-gcp-project-id"

# 리전 (기본값 권장)
GCP_LOCATION="us-central1"

# Veo 모델 ID
# - veo-3.1-fast-generate-001 (빠름, 권장)
VEO_MODEL_ID="veo-3.1-fast-generate-001"

# Gemini 이미지는 global 엔드포인트를 사용합니다.
IMAGE_MODEL_ID="gemini-3.1-flash-lite-image"

# Veo 3.1 지원 길이: 4, 6, 8초. 영상 오디오는 생성하지 않습니다.
VEO_DURATION_SECONDS=8
HYBRID_VEO_DURATION_SECONDS=6

# 한 편의 새 비주얼 출력 예상액 상한 (USD). 명시한 Veo 시도 횟수는 반영합니다.
# 입력 토큰/GPT/TTS/제공자 내부 재시도/세금은 제외됩니다. 기본 Veo 시도는 1회입니다.
MAX_VISUAL_COST_USD=1.0

# 선택: 이 프로그램의 Google 이미지/Veo 요청에 대한 월별 원화 예약 한도.
# 네 값을 모두 개인 config/.env에 설정해야 활성화됩니다. 월은 Cloud Billing의 미국 태평양 시간 기준입니다.
# 기초 사용액에는 이 프로그램 밖의 사용량과 아직 청구 확인 전인 과거 요청을 보수적으로 포함하세요.
# 환산값은 실시간 환율이 아니라 USD 목록가 1달러를 몇 원으로 예약할지 정하는 안전 계수입니다.
# 새 달에는 월과 기초 사용액을 다시 설정해야 Google 요청을 재개할 수 있습니다.
# 최초 설정 후 python -m shorts_maker.services.google_budget --init 으로 장부를 한 번 생성하세요.
# 장부가 삭제되면 새 호출이 차단됩니다. 과거 예약액을 복구하거나 기초 사용액에 합산한 뒤 재초기화하세요.
# GOOGLE_MONTHLY_BUDGET_KRW=10000
# GOOGLE_BUDGET_MONTH=2026-10
# GOOGLE_BUDGET_OPENING_KRW=2000
# GOOGLE_USD_KRW_RESERVE_RATE=2000

# 현재 품질 검토 라운드는 새 유료 API 호출을 기본 차단합니다.
# 스크립트 기획, TTS, 새 비주얼 생성을 재개하기 전 라운드 예산을 정하고
# 제공자 사용량을 확인한 뒤에만 true로 변경하세요. 직접 실행하는 생성 도구에도 적용됩니다.
# true는 총비용 상한이 아닙니다. 위 비주얼 추정 상한과 제공자 과금 확인은 별개입니다.
PAID_PRODUCTION_ENABLED=false

# --------------------------------------------
# 4. Studio Session
# --------------------------------------------
# Studio는 기본적으로 로컬 127.0.0.1:8080에서 실행됩니다.
# 기존 HOST/PORT/DEBUG 환경변수는 실행 진입점에서 사용하지 않습니다.

# NiceGUI 세션 시크릿 (변경 권장)
NICEGUI_STORAGE_SECRET="change-this-to-random-string"

# --------------------------------------------
# 6. Storage Paths (기본값 권장)
# --------------------------------------------
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
TEMP_DIR=./temp

# --------------------------------------------
# 8. Character Assets (Customizable)
# --------------------------------------------
# 캐릭터 오버레이 기능을 사용할 때 자신의 캐릭터 이미지/영상을 지정할 수 있습니다.
# 미설정 시 assets/ 폴더 내의 기본 파일을 찾습니다.
CHARACTER_IMAGE_PATH="assets/character_ref.png"
CHARACTER_VIDEO_PATH="assets/character_video.mp4"
